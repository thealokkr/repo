{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CloudServe decision log event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "run_id",
    "input_index",
    "ticket_id",
    "occurred_at",
    "event_type",
    "actor_type",
    "action_taken",
    "reason",
    "result"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "input_index": {
      "type": "integer",
      "minimum": 0
    },
    "ticket_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_type": {
      "enum": [
        "route_recommended",
        "processing_error"
      ]
    },
    "actor_type": {
      "const": "system"
    },
    "action_taken": {
      "enum": [
        "draft_for_review",
        "escalate",
        "degrade"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "type": "object",
      "required": [
        "run_id",
        "input_index",
        "ticket_id",
        "channel",
        "route",
        "status",
        "reason",
        "draft_response",
        "sources",
        "classification",
        "routing",
        "processing_duration_seconds",
        "draft_generation_request_duration_seconds",
        "processing_latency_seconds",
        "draft",
        "handoff",
        "guardrails",
        "generation"
      ]
    }
  }
}
