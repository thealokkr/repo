{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CloudServe per-ticket result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "input_index",
    "ticket_id",
    "channel",
    "route",
    "status",
    "processing_duration_seconds",
    "draft_generation_request_duration_seconds",
    "processing_latency_seconds",
    "reason",
    "draft_response",
    "draft",
    "generated_labels",
    "handoff",
    "guardrails",
    "generation",
    "sources",
    "classification",
    "routing"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "input_index": {
      "type": "integer",
      "minimum": 0
    },
    "processing_duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "draft_generation_request_duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "processing_latency_seconds": {
      "type": "number",
      "minimum": 0
    },
    "ticket_id": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "enum": [
        "draft_for_review",
        "escalate",
        "degrade"
      ]
    },
    "status": {
      "enum": [
        "completed",
        "failed"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "draft_response": {
      "type": [
        "string",
        "null"
      ]
    },
    "generated_labels": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intent",
            "urgency",
            "expected_route",
            "answerable_from_docs",
            "expected_doc_ids",
            "must_not_auto_respond"
          ],
          "properties": {
            "intent": {
              "enum": [
                "account",
                "account_access",
                "account_compromise",
                "api",
                "api_key_issue",
                "api_usage_question",
                "authentication",
                "authentication_failure",
                "billing",
                "billing_dispute",
                "billing_query",
                "compliance",
                "compliance_request",
                "configuration_help",
                "data",
                "data_export",
                "data_location",
                "data_residency",
                "database_issue",
                "deployment",
                "deployment_failure",
                "feature_request",
                "integration",
                "integration_help",
                "onboarding",
                "other",
                "performance",
                "performance_degradation",
                "quota_or_overage",
                "rate_limit",
                "roadmap_request",
                "rollback_request",
                "security",
                "security_incident",
                "sso_configuration",
                "unclear_request",
                "webhook_issue"
              ]
            },
            "urgency": {
              "enum": [
                "high",
                "medium",
                "low",
                "unknown"
              ]
            },
            "expected_route": {
              "enum": [
                "draft_for_review",
                "escalate",
                "degrade"
              ]
            },
            "answerable_from_docs": {
              "type": "boolean"
            },
            "expected_doc_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "must_not_auto_respond": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "draft": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plain_text",
            "claims",
            "unsupported_points",
            "conflicting_points",
            "approval_required",
            "send_status"
          ],
          "properties": {
            "plain_text": {
              "type": "string",
              "minLength": 1
            },
            "claims": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "source_ids",
                  "citations"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "citations": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "passage_id",
                        "source_ref"
                      ],
                      "properties": {
                        "passage_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "source_ref": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                }
              }
            },
            "unsupported_points": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "conflicting_points": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "approval_required": {
              "const": true
            },
            "send_status": {
              "const": "not_sent"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "handoff": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "issue",
            "context",
            "sources",
            "attempted_steps",
            "uncertainties",
            "reason",
            "owner",
            "next_action"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "issue": {
              "type": "string",
              "minLength": 1
            },
            "context": {
              "type": "object"
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "attempted_steps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "uncertainties": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "next_action": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks"
      ],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check",
              "passed",
              "blocked",
              "evidence",
              "action"
            ],
            "properties": {
              "check": {
                "type": "string",
                "minLength": 1
              },
              "passed": {
                "type": "boolean"
              },
              "blocked": {
                "type": "boolean"
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model_name",
        "reasoning_effort",
        "status",
        "error_code"
      ],
      "properties": {
        "provider": {
          "enum": [
            "offline",
            "openai"
          ]
        },
        "model_name": {
          "type": "string",
          "minLength": 1
        },
        "reasoning_effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "not_attempted",
            "generated",
            "failed"
          ]
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "urgency",
        "confidence",
        "provider",
        "model_name",
        "provider_status"
      ],
      "properties": {
        "intent": {
          "enum": [
            "account",
            "account_access",
            "account_compromise",
            "api",
            "api_key_issue",
            "api_usage_question",
            "authentication",
            "authentication_failure",
            "billing",
            "billing_dispute",
            "billing_query",
            "compliance",
            "compliance_request",
            "configuration_help",
            "data",
            "data_export",
            "data_location",
            "data_residency",
            "database_issue",
            "deployment",
            "deployment_failure",
            "feature_request",
            "integration",
            "integration_help",
            "onboarding",
            "other",
            "performance",
            "performance_degradation",
            "quota_or_overage",
            "rate_limit",
            "roadmap_request",
            "rollback_request",
            "security",
            "security_incident",
            "sso_configuration",
            "unclear_request",
            "webhook_issue"
          ]
        },
        "urgency": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "provider": {
          "enum": [
            "openai",
            "not_attempted"
          ]
        },
        "model_name": {
          "type": "string",
          "minLength": 1
        },
        "provider_status": {
          "enum": [
            "classified",
            "fallback"
          ]
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "matched_rule",
        "protected_case",
        "evidence_ready",
        "confidence_threshold",
        "threshold_source",
        "calibration_method",
        "calibration_source",
        "policy_frozen",
        "policy_provenance",
        "retrieval"
      ],
      "properties": {
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "matched_rule": {
          "type": "string",
          "minLength": 1
        },
        "protected_case": {
          "type": "boolean"
        },
        "evidence_ready": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "confidence_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "threshold_source": {
          "type": "string",
          "minLength": 1
        },
        "calibration_method": {
          "type": "string",
          "minLength": 1
        },
        "calibration_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_set",
            "input_ref",
            "operational_sha256",
            "total_records",
            "valid_operational_records",
            "confidence_sample_count",
            "excluded_invalid_records",
            "failed_classifications",
            "evaluation_fields_used"
          ],
          "properties": {
            "source_set": {
              "const": "development"
            },
            "input_ref": {
              "type": "string",
              "minLength": 1
            },
            "operational_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "total_records": {
              "type": "integer",
              "minimum": 0
            },
            "valid_operational_records": {
              "type": "integer",
              "minimum": 0
            },
            "confidence_sample_count": {
              "type": "integer",
              "minimum": 1
            },
            "excluded_invalid_records": {
              "type": "integer",
              "minimum": 0
            },
            "failed_classifications": {
              "type": "integer",
              "minimum": 0
            },
            "evaluation_fields_used": {
              "const": false
            }
          }
        },
        "policy_frozen": {
          "const": true
        },
        "policy_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy_version",
            "classification_confidence_threshold",
            "threshold_source",
            "calibration_method",
            "calibration_source",
            "frozen",
            "policy_file_sha256",
            "threshold_sha256",
            "classifier_implementation_sha256",
            "classifier_model_sha256"
          ],
          "properties": {
            "policy_version": {
              "type": "string",
              "minLength": 1
            },
            "classification_confidence_threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "threshold_source": {
              "type": "string",
              "minLength": 1
            },
            "calibration_method": {
              "type": "string",
              "minLength": 1
            },
            "calibration_source": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_set",
                "input_ref",
                "operational_sha256",
                "total_records",
                "valid_operational_records",
                "confidence_sample_count",
                "excluded_invalid_records",
                "failed_classifications",
                "evaluation_fields_used"
              ],
              "properties": {
                "source_set": {
                  "const": "development"
                },
                "input_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "operational_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "total_records": {
                  "type": "integer",
                  "minimum": 0
                },
                "valid_operational_records": {
                  "type": "integer",
                  "minimum": 0
                },
                "confidence_sample_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "excluded_invalid_records": {
                  "type": "integer",
                  "minimum": 0
                },
                "failed_classifications": {
                  "type": "integer",
                  "minimum": 0
                },
                "evaluation_fields_used": {
                  "const": false
                }
              }
            },
            "frozen": {
              "const": true
            },
            "policy_file_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "threshold_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "classifier_implementation_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "classifier_model_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "retrieval": {
          "type": "object"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "route": {
            "const": "draft_for_review"
          }
        },
        "required": [
          "route"
        ]
      },
      "then": {
        "properties": {
          "draft": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "plain_text",
              "claims",
              "unsupported_points",
              "conflicting_points",
              "approval_required",
              "send_status"
            ],
            "properties": {
              "plain_text": {
                "type": "string",
                "minLength": 1
              },
              "claims": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "text",
                    "source_ids",
                    "citations"
                  ],
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_ids": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    },
                    "citations": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "passage_id",
                          "source_ref"
                        ],
                        "properties": {
                          "passage_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "source_ref": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  }
                }
              },
              "unsupported_points": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "conflicting_points": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "approval_required": {
                "const": true
              },
              "send_status": {
                "const": "not_sent"
              }
            }
          },
          "draft_response": {
            "type": "string",
            "minLength": 1
          },
          "handoff": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "draft": {
            "type": "null"
          },
          "draft_response": {
            "type": "null"
          },
          "handoff": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "summary",
              "issue",
              "context",
              "sources",
              "attempted_steps",
              "uncertainties",
              "reason",
              "owner",
              "next_action"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "issue": {
                "type": "string",
                "minLength": 1
              },
              "context": {
                "type": "object"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "attempted_steps": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "uncertainties": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "next_action": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
