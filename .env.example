# The Decisions API classifies tickets; Google Gemini also supplies retrieval embeddings and drafts.
# Add an API key before running the CLI; empty keys cause safe per-ticket fallbacks.
# Supports either GEMINI_API_KEY or GOOGLE_API_KEY.
DRAFT_GENERATION_PROVIDER=GEMINI
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-3.8-flash
GEMINI_QUALITY_JUDGE_MODEL=gemini-3.8-flash
