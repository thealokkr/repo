# Credential-free default. Retrieval safely returns no source until an index is
# available and an embedding credential is configured.
LLM_PROVIDER=OFFLINE
DRAFT_GENERATION_PROVIDER=OFFLINE
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-6-luna
OPENAI_QUALITY_JUDGE_MODEL=gpt-6-luna
