# The Decisions API classifies tickets; OpenAI also supplies retrieval embeddings and drafts.
# Add an API key before running the CLI; empty keys cause safe per-ticket fallbacks.
DRAFT_GENERATION_PROVIDER=OPENAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-6-luna
OPENAI_QUALITY_JUDGE_MODEL=gpt-6-luna
